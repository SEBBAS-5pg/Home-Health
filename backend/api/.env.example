# ──────────────────────────────────────────────────────────────────
# Home-Health API — variables de entorno
# Copiar a `.env` y completar los valores reales.
# ──────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Base de datos PostgreSQL
DATABASE_URL=postgresql://hh_user:hh_pass@localhost:5432/home_health?schema=public

# JWT
JWT_ACCESS_SECRET=cambia-esto-en-prod-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-esto-en-prod-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting (peticiones por minuto por IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Seed inicial
SEED_ADMIN_EMAIL=admin@home-health.app
SEED_ADMIN_PASSWORD=Admin12345!

# Logs
LOG_LEVEL=info
