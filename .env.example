# ───────────────────────────────────────────────────────────────
# Variables de entorno de Home-Health (raíz).
# Copiar a `.env` y completar antes de `docker compose up`.
# ───────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# ─── Base de datos ─────────────────────────────────────────────
DB_USER=hh_user
DB_PASSWORD=hh_pass
DB_NAME=home_health
DB_PORT=5432

# ─── Backend ───────────────────────────────────────────────────
API_PORT=4000

# Mínimo 16 caracteres cada uno. En producción usar valores aleatorios fuertes
# (ej. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=cambia-esto-en-produccion-access-min-16-chars
JWT_REFRESH_SECRET=cambia-esto-en-produccion-refresh-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Orígenes permitidos por CORS (coma para varios). Apuntar al dominio público
# del frontend en producción (ej. https://home-health.app).
CORS_ORIGIN=http://localhost:3000

# Cuenta admin sembrada al inicializar la BD.
SEED_ADMIN_EMAIL=admin@home-health.app
SEED_ADMIN_PASSWORD=Admin12345!

# ─── Frontend ──────────────────────────────────────────────────
WEB_PORT=3000

# URL pública del backend (la usa el navegador del usuario).
# Se inlinea en el bundle de Next.js durante el build.
# En local: http://localhost:4000/api
# En AWS: https://api.home-health.app/api
PUBLIC_API_URL=http://localhost:4000/api
